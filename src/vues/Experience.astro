---
import Base from '../layouts/Base.astro';
import Bande from '../components/Bande.astro';
import AppelFinal from '../components/AppelFinal.astro';
import Icone from '../components/Icone.astro';
import textes from '../i18n/experience';
import type { Langue } from '../i18n/routes';

interface Props { langue: Langue }
const { langue } = Astro.props;
const t = textes[langue];

/* Icônes des quatre apports et des quatre outils, dans l'ordre des items du texte. */
const icones = ['code', 'risque', 'budget', 'audit'] as const;
const iconesOutils = ['mobile', 'navigateur', 'donnees', 'tranches'] as const;
/** Taille de chaque terrain dans la mosaïque, dans l'ordre des items : deux rangées alternées, puis trois tiers. */
const formats = ['large', 'moyen', 'moyen', 'large', 'tiers', 'tiers', 'tiers'] as const;
---
<Base titre={t.meta.titre} description={t.meta.description} langue={langue} page="experience">
  <Bande hauteur="640px" biais="52%" reserve="0px">
    <div class="ouv w">
      <div>
        <span class="etiq">{t.etiquette}</span>
        <h1 data-ajuste>{t.titre.gras}<br /><span class="leger">{t.titre.leger}</span></h1>
        <p class="sous" set:html={t.sous} />
      </div>
      <dl class="triade">
        {t.triade.map((m) => (
          <div class="mot"><dt translate="no">{m.mot}</dt><dd set:html={m.html} /></div>
        ))}
      </dl>
    </div>
  </Bande>

  <section class="sec w apports">
    <div class="deux">
      <h2 class="t2">{t.apports.titre}</h2>
      <p class="lead">{t.apports.lead}</p>
    </div>
    <div class="grille-2">
      {t.apports.items.map((a, i) => <article class="carte"><div class="tete-carte"><div class="ico"><Icone nom={icones[i]} /></div><h3>{a.titre}</h3></div><p class="long">{a.texte}</p></article>)}
    </div>
  </section>

  <section class="sec w creme">
    <div class="deux">
      <h2 class="t2">{t.terrains.titre}</h2>
      <p class="lead">{t.terrains.lead}</p>
    </div>
    <ul class="mosaique">
      {t.terrains.items.map((tr, i) => (
        <li class={`terrain terrain--${formats[i]}`}>
          <p class="milieu">{tr.milieu}</p>
          <h3>{tr.enjeu}</h3>
          <p class="recit">{tr.recit}</p>
          <ul class="mots">{tr.cles.map((cle) => <li>{cle}</li>)}</ul>
        </li>
      ))}
    </ul>
  </section>

  <section class="sec w sombre">
    <div class="tete"><h2 class="t2">{t.convictions.titre}</h2></div>
    <div class="grille-3">
      {t.convictions.items.map((cv) => <article class="carte"><h3>{cv.titre}</h3><p>{cv.texte}</p></article>)}
    </div>
  </section>

  <section class="sec w">
    <div class="outils">
      <div><h2 class="t2">{t.outils.titre}</h2><p class="lead">{t.outils.lead}</p></div>
      <div class="grille-2">
        {t.outils.items.map((o, i) => <article class="carte carte--bord"><div class="tete-carte"><div class="ico"><Icone nom={iconesOutils[i]} /></div><h3>{o.titre}</h3></div><p>{o.texte}</p></article>)}
      </div>
    </div>
  </section>

  <AppelFinal titre={t.appel.titre} texte={t.appel.texte} langue={langue} />
</Base>

<style>
  /* ---------- ouverture : les trois mots du nom, en cartes qui sortent du bandeau ---------- */
  .ouv { display: grid; grid-template-columns: minmax(0, 560px) minmax(0, 1fr); gap: 70px; padding-top: 56px; }
  /* Chaque ligne du titre tient sur une ligne : la taille suit la colonne (coefficient calé sur la plus longue ligne du texte actuel). */
  .ouv > div:first-child { container-type: inline-size; }
  .ouv h1 { font-size: min(clamp(2.75rem, 6vw, 4.5rem), 10.2cqi); }
  .triade { display: grid; gap: 14px; margin: 10px 0 0; }
  .mot { background: #fff; color: var(--encre); border-radius: 24px; padding: 24px 26px; display: grid; grid-template-columns: 150px 1fr; gap: 20px; box-shadow: 0 30px 60px -30px rgba(30,10,4,.5); }
  .mot dt { font-size: 36px; letter-spacing: -.04em; font-weight: 800; color: var(--f2); line-height: 1; }
  .mot dd { margin: 0; font-size: 15px; line-height: 1.55; color: var(--encre-2); }
  .mot strong { color: var(--encre); }

  /* Le bas du bandeau est en biais : sa pointe basse, à gauche, arrive au niveau du titre sans ce supplément. */
  .apports { padding-top: clamp(112px, 13vw, 190px); }
  .deux { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: end; margin-bottom: 56px; }
  .deux .lead { margin: 0; }

  /* Icône et titre sur la même ligne. */
  .tete-carte { display: flex; align-items: center; gap: 16px; margin-bottom: 14px; }
  .tete-carte .ico { flex: none; margin: 0; }
  .tete-carte h3 { margin: 0; line-height: 1.2; }

  /* ---------- terrains : une mosaïque d'enjeux ; le milieu en étiquette, les mots-clés toujours visibles ---------- */
  .mosaique { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 16px; }
  .terrain { display: flex; flex-direction: column; background: #fff; border: 1px solid var(--trait); border-radius: 26px; padding: 30px; transition: transform .25s ease, box-shadow .25s ease, border-color .25s; }
  .terrain--large { grid-column: span 7; }
  .terrain--moyen { grid-column: span 5; }
  .terrain--tiers { grid-column: span 4; }
  .terrain:hover { transform: translateY(-4px); border-color: #F2C9B4; box-shadow: 0 30px 50px -34px rgba(110,34,19,.55); }
  .milieu { display: flex; align-items: center; gap: 9px; font-size: 13.5px; font-weight: 700; color: var(--f2); margin: 0 0 18px; }
  .milieu::before { content: ''; flex: none; width: 8px; height: 8px; border-radius: 50%; background: currentColor; }
  .terrain h3 { font-size: 25px; line-height: 1.12; letter-spacing: -.03em; font-weight: 800; margin-bottom: 14px; }
  .terrain--large h3 { font-size: clamp(26px, 2.5vw, 34px); }
  .recit { font-size: 15.5px; line-height: 1.6; color: var(--encre-2); margin: 0 0 24px; }
  .mots { list-style: none; margin: auto 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .mots li { font-size: 13px; font-weight: 600; padding: 7px 12px; border-radius: 99px; background: var(--creme); border: 1px solid var(--trait); }
  /* Le premier terrain porte la couleur Braise : l'œil entre par lui. */
  .terrain:first-child { background: linear-gradient(135deg, var(--f1), var(--f2) 60%, var(--f3)); border-color: transparent; color: #fff; }
  .terrain:first-child .milieu { color: rgba(255,255,255,.85); }
  .terrain:first-child .recit { color: rgba(255,255,255,.88); }
  .terrain:first-child .mots li { background: rgba(255,255,255,.14); border-color: rgba(255,255,255,.26); }
  .terrain:first-child:hover { box-shadow: 0 34px 60px -30px rgba(110,34,19,.75); }
  @media (prefers-reduced-motion: reduce) { .terrain, .terrain:hover { transition: none; transform: none; } }

  .outils { display: grid; grid-template-columns: 1fr 1.3fr; gap: 80px; }

  /* ---------- adaptation ---------- */
  @media (max-width: 1100px) {
    .ouv, .deux, .outils { grid-template-columns: 1fr; gap: 32px; }
    .deux { margin-bottom: 40px; }
    .triade { padding-bottom: 40px; }
    .mosaique { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .terrain--large, .terrain--moyen, .terrain--tiers { grid-column: span 1; }
    .terrain:first-child { grid-column: span 2; }
  }
  @media (max-width: 700px) {
    .mot { grid-template-columns: 1fr; gap: 8px; }
    .mosaique { grid-template-columns: 1fr; }
    .terrain:first-child { grid-column: auto; }
    .terrain { padding: 24px; }
    .terrain h3, .terrain--large h3 { font-size: 23px; }
  }
  /* Les deux derniers mots d'un titre de carte restent liés (« même conversation ») : sur les plus
     petits écrans, icône, titre et marges se resserrent pour que ce bloc tienne à côté de l'icône. */
  @media (max-width: 400px) {
    .carte { padding: 22px; }
    .tete-carte { gap: 12px; }
    .tete-carte .ico { width: 40px; height: 40px; border-radius: 12px; }
    .tete-carte h3 { font-size: 19px; }
  }
</style>
